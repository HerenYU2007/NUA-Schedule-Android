<?xml version="1.0" encoding="utf-8"?>
<cn.nua.wenguan.schedule.ui.ResponsiveScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设置"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/settings_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="课表与日期"
            android:textColor="@color/brand_navy"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/set_school_start"
            style="@style/SettingsAction"
            android:drawableStart="@drawable/ic_ui_calendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="选择开学时间" />

        <Button
            android:id="@+id/manual_import"
            style="@style/SettingsAction"
            android:drawableStart="@drawable/ic_ui_file"
            android:drawableTint="@color/action_green"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="手动导入学校导出的 XLS" />

        <Button
            android:id="@+id/theme_settings"
            style="@style/SettingsAction"
            android:drawableStart="@drawable/ic_ui_theme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="界面主题：跟随系统" />

        <Button
            android:id="@+id/mode_settings"
            style="@style/SettingsAction"
            android:drawableStart="@drawable/ic_ui_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="课表展示：列表课表" />

        <Button
            android:id="@+id/clear_schedule"
            style="@style/SettingsActionDanger"
            android:drawableStart="@drawable/ic_ui_trash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="清空已导入课表" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="小组件与提醒"
            android:textColor="@color/brand_navy"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/add_widget"
            style="@style/SettingsAction"
            android:drawableStart="@drawable/ic_ui_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="添加桌面小组件" />

        <Button
            android:id="@+id/reminder_button"
            style="@style/SettingsAction"
            android:drawableStart="@drawable/ic_ui_bell"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="上课提醒设置" />

        <Button android:id="@+id/widget_diagnostics" style="@style/SettingsAction" android:drawableStart="@drawable/ic_ui_grid" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="小组件刷新与诊断" />
        <Button android:id="@+id/background_help" style="@style/SettingsAction" android:drawableStart="@drawable/ic_ui_settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="电池优化与后台权限" />
        <Button android:id="@+id/transfer_schedule" style="@style/SettingsAction" android:drawableStart="@drawable/ic_ui_file" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="导出 / 恢复课表" />
        <Button android:id="@+id/debug_mode" style="@style/SettingsAction" android:drawableStart="@drawable/ic_ui_settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="调试模式：已关闭" />

        <Button
            android:id="@+id/back_button"
            style="@style/ModernButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="返回课表" />
    </LinearLayout>
</cn.nua.wenguan.schedule.ui.ResponsiveScrollView>
