<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_date"
                android:includeFontPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_summary"
                android:includeFontPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_previous"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="切换到今天"
            android:padding="6dp"
            android:text="‹ 今"
            android:textColor="@color/widget_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_next"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="切换到明天"
            android:padding="6dp"
            android:text="明 ›"
            android:textColor="@color/widget_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_refresh"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="刷新课表"
            android:padding="6dp"
            android:text="↻"
            android:textColor="@color/widget_muted"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_courses"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="top"
        android:orientation="vertical">

    <LinearLayout
        android:id="@+id/widget_course_row_1"
        style="@style/PhoneWidgetCourseContainer">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_course_time_1"
                    style="@style/PhoneWidgetCourseTime" />

                <TextView
                    android:id="@+id/widget_course_name_1"
                    style="@style/PhoneWidgetCourseName" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_course_detail_1"
                style="@style/PhoneWidgetCourseDetail" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_course_status_1"
            style="@style/PhoneWidgetCourseStatus" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_course_row_2"
        style="@style/PhoneWidgetCourseContainer">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_course_time_2"
                    style="@style/PhoneWidgetCourseTime" />

                <TextView
                    android:id="@+id/widget_course_name_2"
                    style="@style/PhoneWidgetCourseName" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_course_detail_2"
                style="@style/PhoneWidgetCourseDetail" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_course_status_2"
            style="@style/PhoneWidgetCourseStatus" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_course_row_3"
        style="@style/PhoneWidgetCourseContainer">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_course_time_3"
                    style="@style/PhoneWidgetCourseTime" />

                <TextView
                    android:id="@+id/widget_course_name_3"
                    style="@style/PhoneWidgetCourseName" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_course_detail_3"
                style="@style/PhoneWidgetCourseDetail" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_course_status_3"
            style="@style/PhoneWidgetCourseStatus" />
    </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/widget_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:textColor="@color/widget_muted"
        android:textSize="10sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="@color/widget_muted"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
